# ============================================================
# Variables de entorno — Registro de Actividades
# Copia este archivo como ".env" y completa los valores.
# ".env" NUNCA debe subirse a git (ya está en .gitignore).
# ============================================================

# --- Flask (interfaz web) ---
# Clave usada para firmar la cookie de sesión. Obligatoria en producción;
# si no se define, app.py usa "dev-only-not-secure" (solo para desarrollo local).
# Generarla con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Base de datos ---
# Ruta al archivo SQLite. Opcional: si se omite, se usa data/activities.db
ACTIVITY_DB_PATH=

# --- CLI (main.py) ---
# Credenciales para uso no interactivo del CLI (evita pasar --email/--password
# en cada comando). Deben corresponder a una cuenta ya registrada vía la web
# o creada directamente en la base de datos.
ACTIVITY_CLI_EMAIL=
ACTIVITY_CLI_PASSWORD=

# ============================================================
# Reservado para próximas fases (aún no usado por el código)
# ============================================================

# --- Fase 2: cifrado de datos (cryptography) ---
# Clave maestra para cifrar/descifrar actividades y adjuntos antes de
# guardarlos o sincronizarlos. Nunca debe hardcodearse ni subirse a git.
ACTIVITY_MASTER_KEY=

# --- Fase 3: sincronización en la nube ---
# GITHUB_TOKEN=
# GITHUB_REPO=
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# MEGA_EMAIL=
# MEGA_PASSWORD=
